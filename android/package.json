{
  "name": "crush-of-roses-android",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "sync:dev": "CRUSH_SITE=dev npx cap sync android",
    "sync:live": "CRUSH_SITE=live npx cap sync android",
    "sync:ios-dev": "CRUSH_SITE=dev npx cap sync ios",
    "sync:ios-live": "CRUSH_SITE=live npx cap sync ios",
    "build:dev": "npm run sync:dev && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../crush-of-roses-dev.apk",
    "build:live": "npm run sync:live && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../crush-of-roses.apk",
    "open": "npx cap open android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
